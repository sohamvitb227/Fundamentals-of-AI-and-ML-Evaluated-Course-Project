import os
import cv2
import numpy as np
from tkinter import *
from tkinter import filedialog, messagebox
from PIL import Image

selected_files = []

# --- AI Logic: Load Super-Resolution Model ---
# This uses a Deep Learning model to upscale images while maintaining sharpness
def upscale_image_ai(image_path, scale):
    sr = cv2.dnn_superres.DnnSuperResImpl_create()
    
    # Fundamentals of AI: Using a Pre-trained Model (Transfer Learning)
    # Note: You would typically download 'EDSR_x2.pb' from OpenCV's model zoo
    path = "EDSR_x2.pb" 
    
    try:
        # Load the model architecture and weights
        sr.readModel(path)
        sr.setModel("edsr", scale) # Scale can be 2, 3, or 4
        
        img = cv2.imread(image_path)
        result = sr.upsample(img)
        
        # Convert BGR (OpenCV) back to RGB (PIL)
        result = cv2.cvtColor(result, cv2.COLOR_BGR2RGB)
        return Image.fromarray(result)
    except:
        # Fallback to standard Lanczos interpolation if AI model is missing
        img = Image.open(image_path)
        w, h = img.size
        return img.resize((w * scale, h * scale), Image.LANCZOS)

def select_images():
    global selected_files
    files = filedialog.askopenfilenames(
        title='CHOOSE IMAGES',
        filetypes=[("Image files", "*.jpg *.jpeg *.png *.bmp *.webp")]
    )
    if files:
        selected_files = list(files)
        status_label.config(text=f"{len(selected_files)} IMAGES READY!", fg="#4CAF50")

def process_images():
    if not selected_files:
        messagebox.showwarning("Warning", "PLEASE SELECT IMAGES FIRST")
        return

    mode = mode_var.get()
    use_ai = ai_var.get()
    processed_images = []

    if mode == "PDF":
        save_path = filedialog.asksaveasfilename(defaultextension=".pdf", filetypes=[("PDF files", "*.pdf")])
        if not save_path: return
    else:
        output_dir = filedialog.askdirectory(title="SELECT SAVE FOLDER")
        if not output_dir: return

    try:
        for path in selected_files:
            # Fundamentals of AI: Conditional Logic 
            # If AI is enabled and we are enlarging, use the Neural Network
            if use_ai and mode == "Expand":
                resized_image = upscale_image_ai(path, 2) # Fixed 2x AI Upscaling
            else:
                # Standard Computer Vision (Bicubic/Lanczos)
                img = Image.open(path)
                scale = 0.5 if mode == "Shrink" else 1.0
                new_size = (int(img.size[0] * scale), int(img.size[1] * scale))
                resized_image = img.resize(new_size, Image.LANCZOS)

            if resized_image.mode in ("RGBA", "P"):
                resized_image = resized_image.convert("RGB")

            if mode == "PDF":
                processed_images.append(resized_image)
            else:
                name = os.path.basename(path)
                prefix = 'AI_ENHANCED_' if use_ai else 'PROCESSED_'
                save_at = os.path.join(output_dir, f"{prefix}{name}")
                resized_image.save(save_at, format='JPEG', quality=90)

        if mode == "PDF" and processed_images:
            processed_images[0].save(save_path, save_all=True, append_images=processed_images[1:])

        messagebox.showinfo('SUCCESS', 'AI PROCESSING COMPLETED!')
        
    except Exception as e:
        messagebox.showerror("Error", f"An error occurred: {e}")

# --- UI Setup ---
app = Tk()
app.title("AI Image Neural-Morpher")
app.geometry("450x650")
app.config(padx=20, pady=20, bg="#1a1a1a") # Dark mode aesthetic

Label(app, text="Neural Image Morpher", font=("Helvetica", 20, "bold"), bg="#1a1a1a", fg="white").pack(pady=10)

Button(app, text="📂 Select Images", command=select_images, width=25, bg="#333", fg="white").pack(pady=10)
status_label = Label(app, text="No images selected", bg="#1a1a1a", fg="#888")
status_label.pack()

# AI Selection
ai_var = BooleanVar(value=False)
Checkbutton(app, text="Use AI Neural Enhancement (Upscaling Only)", variable=ai_var, 
            bg="#1a1a1a", fg="#00dbde", selectcolor="#1a1a1a", activebackground="#1a1a1a").pack(pady=10)

Label(app, text="Mode Select:", bg="#1a1a1a", fg="white", font=("Arial", 10, "bold")).pack(pady=(10, 5))
mode_var = StringVar(value="Shrink")
Radiobutton(app, text="Shrink (50%)", variable=mode_var, value="Shrink", bg="#1a1a1a", fg="white", selectcolor="#333").pack()
Radiobutton(app, text="Expand (2x)", variable=mode_var, value="Expand", bg="#1a1a1a", fg="white", selectcolor="#333").pack()
Radiobutton(app, text="Merge to PDF", variable=mode_var, value="PDF", bg="#1a1a1a", fg="white", selectcolor="#333").pack()

Button(app, text="🚀 RUN NEURAL ENGINE", command=process_images, bg="#00dbde", fg="black", 
       font=("Arial", 12, "bold"), height=2, width=30).pack(pady=40)

app.mainloop()
